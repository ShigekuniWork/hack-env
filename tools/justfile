_default:
    @just --list

[group('dev')]
lint:
    golangci-lint run ./...

[group('dev')]
fmt:
    golangci-lint fmt

[group('dev')]
fix:
    golangci-lint run ./... --fix

[group('dev')]
test:
    go test ./...

# Sift: 入力値の絞り込や、正規表現の生成で使用。
[group('sift')]
sift *args:
    go run ./sift {{args}}

# Sift: 入力・出力ファイルを指定して絞り込む。
[group('sift')]
sift-filter input output *args:
    @go run ./sift -input {{quote(input)}} -output {{quote(output)}} {{args}}

# Sift: 条件から PCRE2 正規表現を生成する（既定は標準出力）。
[group('sift')]
sift-regex *args:
    @go run ./sift regex {{args}}
